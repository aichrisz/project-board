{
  "name": "project-board",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && VITE_BASE=/project-board/ vite build && cp dist/index.html dist/404.html",
    "lint": "oxlint",
    "test": "node --import ./scripts/test-resolve-hook.mjs --test \"src/**/*.test.ts\"",
    "test:server": "node --test server/app.test.mjs",
    "test:cli": "node --test scripts/project-board.test.mjs",
    "start": "node server/app.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
